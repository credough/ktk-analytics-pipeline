# Facebook Page ID; find it in your Meta Page settings.
PAGE_ID=your_page_id_here
# Facebook system-user access token; create it in Meta Business Settings under System users.
FB_SYSTEM_TOKEN=replace_with_facebook_system_user_token
# Supabase project URL; find it in your Supabase project's API settings.
SUPABASE_URL=https://your-project-id.supabase.co
# Supabase service_role key; find it in your Supabase project's API settings.
SUPABASE_KEY=replace_with_supabase_service_role_key